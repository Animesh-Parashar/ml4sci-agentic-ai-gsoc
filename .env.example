# DeepLense Agent - Environment Configuration
# Copy this file to .env and fill in your API keys.
# .env is gitignored and will never be committed.

# Primary key (used first)
GEMINI_API_KEY=your-gemini-key-here

# Additional keys for automatic rotation when the first key hits quota.
# Add as many as you need by incrementing the suffix.
# GEMINI_API_KEY_2=your-second-gemini-key
# GEMINI_API_KEY_3=your-third-gemini-key

# OpenAI (paid) 
# OPENAI_API_KEY=sk-...
# OPENAI_API_KEY_2=sk-...

#  Ollama (fully local, no key needed) 
# No key required. Install Ollama (https://ollama.com/) and pull a model:
#   ollama pull llama3.2
# Then select "Ollama (local)" in the sidebar and type the model name.

# Optional: override the model at launch (bypasses the sidebar selector) 
# LENSING_AGENT_MODEL=google-gla:gemini-2.0-flash
